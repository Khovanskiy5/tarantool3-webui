# ──────────────────────────────────────────────────────────────
# Generated assets
# ──────────────────────────────────────────────────────────────
# Embedded SPA bundle, produced by tools/embed-assets
backend/webui/assets/bundle.lua
backend/webui/assets/bundle/

# GraphQL TS types, produced by graphql-codegen
frontend/src/api/generated.ts
frontend/src/api/generated/
# graphql-codegen output (client-preset)
frontend/src/shared/api/__generated/

# Tarantool cluster-config JSON schema, regenerated from a running
# instance via tools/dump-config-schema.sh and consumed by IDEs
# (jetbrains JSON Schema mapping in .idea/jsonSchemas.xml).
docker/configs/cluster.schema.json

