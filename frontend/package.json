{
  "name": "@webui/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "type-check": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "check-fsd": "eslint --rulesdir ./tools/eslint-rules --no-eslintrc --config .eslintrc.fsd.cjs 'src/**/*.{ts,vue}' --max-warnings 0",
    "check-i18n": "node tools/check-i18n.mjs"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "pinia": "^2.1.7",
    "vue-i18n": "^9.13.1",
    "@urql/vue": "^1.3.0",
    "graphql": "^16.9.0",
    "primevue": "^4.0.0",
    "primeicons": "^7.0.0",
    "@primevue/themes": "^4.0.0",
    "dayjs": "^1.11.10",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@types/node": "^20.14.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.57.0",
    "eslint-plugin-boundaries": "^4.2.2",
    "eslint-plugin-vue": "^9.27.0",
    "happy-dom": "^14.12.0",
    "monaco-editor": "^0.50.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-compression2": "^2.5.3",
    "vitest": "^2.0.0",
    "vue-tsc": "^2.0.21"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
