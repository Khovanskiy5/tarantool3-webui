{
  "name": "@webui/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "type-check": "vue-tsc --noEmit",
    "test:unit": "NODE_OPTIONS='--no-warnings=ExperimentalWarning' vitest run",
    "test:unit:watch": "NODE_OPTIONS='--no-warnings=ExperimentalWarning' vitest",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static"
  },
  "dependencies": {
    "@primevue/themes": "4.5.4",
    "@urql/vue": "2.1.0",
    "ajv": "8.20.0",
    "dayjs": "1.11.21",
    "graphql": "16.14.1",
    "pinia": "3.0.4",
    "primeicons": "7.0.0",
    "primevue": "4.5.5",
    "vue": "3.5.35",
    "vue-i18n": "11.4.4",
    "vue-router": "5.1.0"
  },
  "devDependencies": {
    "@graphql-codegen/add": "7.0.1",
    "@graphql-codegen/cli": "7.1.2",
    "@graphql-codegen/client-preset": "6.0.1",
    "@graphql-codegen/import-types-preset": "4.0.1",
    "@graphql-codegen/typescript": "6.0.2",
    "@graphql-codegen/typescript-operations": "6.0.3",
    "@graphql-codegen/typescript-urql": "5.0.1",
    "@graphql-codegen/typescript-vue-urql": "4.0.1",
    "@playwright/test": "1.60.0",
    "@storybook/addon-a11y": "10.4.1",
    "@storybook/addon-themes": "10.4.1",
    "@storybook/addon-vitest": "10.4.1",
    "@storybook/vue3": "10.4.1",
    "@storybook/vue3-vite": "10.4.1",
    "@types/node": "25.9.1",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue/eslint-config-typescript": "14.7.0",
    "@vue/test-utils": "2.4.6",
    "eslint": "10.4.1",
    "eslint-plugin-boundaries": "6.0.2",
    "eslint-plugin-vue": "10.9.1",
    "globals": "17.6.0",
    "graphql-tag": "2.12.6",
    "happy-dom": "20.9.0",
    "monaco-editor": "0.55.1",
    "prettier": "3.8.3",
    "storybook": "10.4.1",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vite-plugin-compression2": "2.5.3",
    "vitest": "4.1.8",
    "vitest-websocket-mock": "0.5.0",
    "vue-tsc": "3.3.3",
    "wonka": "6.3.6"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
